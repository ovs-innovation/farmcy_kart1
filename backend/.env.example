# Backend Environment Template (Production / Ubuntu 24.04 VPS)

# Server Configuration
PORT=5000
NODE_ENV=production

# Database (MongoDB Atlas)
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database_name>?retryWrites=true&w=majority

# Authentication & Security
JWT_SECRET=your_jwt_secret_min_32_characters
JWT_SECRET_FOR_VERIFY=your_verification_jwt_secret
ENCRYPT_PASSWORD=your_32_byte_aes_encryption_key

# Domain URLs (CORS & Redirects)
FRONTEND_URL=https://farmacycart.com
STORE_URL=https://farmacycart.com
ADMIN_URL=https://admin.farmacycart.com

# Email Services (Resend / SMTP)
RESEND_API_KEY=
EMAIL_USER=
EMAIL_PASS=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false

# SMS / OTP (MSG91)
MSG91_AUTH_KEY=
MSG91_OTP_TEMPLATE_ID=
MSG91_TEMPLATE_ID=
MSG91_SENDER_ID=FARMCY

# Payment Gateways (Optional)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
STRIPE_KEY=
STRIPE_SECRET=

# Logistics (Shiprocket)
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=

# Media Storage (Cloudinary)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_PRESET=

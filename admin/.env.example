# Admin Environment Template (Production / Vite React SPA)

# API & Domain URLs
VITE_APP_API_BASE_URL=https://api.farmacycart.com/api
VITE_APP_STORE_DOMAIN=https://farmacycart.com
VITE_APP_ADMIN_DOMAIN=https://admin.farmacycart.com

# RBAC Encryption Password (Must match backend ENCRYPT_PASSWORD)
VITE_APP_ENCRYPT_PASSWORD=your_32_byte_aes_encryption_key

# Cloudinary (Admin Media Uploads)
VITE_APP_CLOUD_NAME=
VITE_APP_CLOUDINARY_API_KEY=
VITE_APP_CLOUDINARY_UPLOAD_PRESET=
VITE_APP_CLOUDINARY_URL=https://api.cloudinary.com/v1_1/<cloud_name>/image/upload
VITE_APP_CLOUDINARY_VIDEO_URL=

# Firebase (Admin FCM Push Notifications)
VITE_APP_FIREBASE_API_KEY=
VITE_APP_FIREBASE_AUTH_DOMAIN=
VITE_APP_FIREBASE_PROJECT_ID=
VITE_APP_FIREBASE_STORAGE_BUCKET=
VITE_APP_FIREBASE_MESSAGING_SENDER_ID=
VITE_APP_FIREBASE_APP_ID=
VITE_APP_FIREBASE_MEASUREMENT_ID=
VITE_APP_FIREBASE_VAPID_KEY=

# Translation API (Optional)
VITE_APP_MYMEMORY_API_KEY=
VITE_APP_DISABLE_FOR_DEMO=false
